vehicles = {
    "LEA-1234": {
        "owner": "Ali Ahmed",
        "city": "Lahore",
        "vehicle": "Toyota Corolla",
        "model": "2022"
    },
    "KHI-5678": {
        "owner": "Usman Khan",
        "city": "Karachi",
        "vehicle": "Honda Civic",
        "model": "2021"
    },
    "MUX-9012": {
        "owner": "Ahmed Raza",
        "city": "Multan",
        "vehicle": "Suzuki Alto",
        "model": "2023"
    },
    "ISB-3456": {
        "owner": "Hassan Ali",
        "city": "Islamabad",
        "vehicle": "Toyota Yaris",
        "model": "2020"
    }
}

print("=" * 45)
print("   VEHICLE NUMBER PLATE VERIFICATION")
print("        EDUCATIONAL DEMO")
