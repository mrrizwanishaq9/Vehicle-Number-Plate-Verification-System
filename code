    data = vehicles[plate]

    print("\nVehicle Found!")
    print("-" * 45)
    print("Number Plate :", plate)
    print("Owner Name   :", data["owner"])
    print("City         :", data["city"])
    print("Vehicle      :", data["vehicle"])
    print("Model        :", data["model"])
    print("-" * 45)

else:
    print("\n❌ Vehicle record not found.")
    print("Please check the number plate.")
